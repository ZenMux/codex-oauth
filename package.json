{
  "name": "@zenmux/codex-oauth",
  "version": "0.2.3",
  "description": "OAuth 2.0 PKCE authentication helper for using ZenMux as a custom model provider in Codex",
  "type": "module",
  "bin": {
    "zenmux-codex-auth": "./bin/zenmux-codex-auth.mjs"
  },
  "files": [
    ".codex-plugin",
    "bin",
    "skills",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "zenmux",
    "oauth",
    "pkce",
    "responses-api",
    "llm"
  ],
  "author": {
    "name": "zenmux",
    "email": "jx@zenmux.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenMux/codex-oauth.git"
  },
  "homepage": "https://github.com/ZenMux/codex-oauth#readme",
  "bugs": {
    "url": "https://github.com/ZenMux/codex-oauth/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node --check bin/zenmux-codex-auth.mjs && node --check src/cli.mjs && node --check src/oauth.mjs && node --check src/storage.mjs && node --check src/codex-config.mjs && node --check src/model-catalog.mjs && node --check src/proxy.mjs",
    "test": "npm run check && node --test",
    "prepack": "npm test",
    "dev:setup": "node scripts/dev-environment.mjs setup",
    "dev:login": "node scripts/dev-environment.mjs login",
    "dev:status": "node scripts/dev-environment.mjs status",
    "dev:codex": "node scripts/dev-environment.mjs codex"
  }
}
